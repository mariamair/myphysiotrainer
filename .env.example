# *** ENVIRONMENT VARIABLES FOR DEVELOPMENT ***
# --------------------------------------------
# Rename as .env and replace the examples with your values. Docker finds and loads the file automatically if it is called .env. You don't have to specify it on the command line.
# Note: Never push secrets to repository!

# DATABASE
# Fill in your database connection string instead of the examples
# 'mongodb' is the name of the database service in docker-compose.yml
DB_CONNECTION_STRING='mongodb://mongodb:27017/my-db-name-dev'

# APPLICATION
NODE_ENV='development'
PORT=8080
BASE_URL='/'
API_URL='http://localhost:8080/api/v1'
SESSION_NAME='my-session-name-dev'
SESSION_SECRET='my-session-secret'

LOG_LEVEL='silly'
LOGGER_COMBINED_LOG_FILE='/app/logs/combined.log'
LOGGER_ERROR_LOG_FILE='/app/logs/error.log'
LOGGER_UNCAUGHT_EXCEPTION_LOG_FILE='/app/logs/uncaught-exception.log'